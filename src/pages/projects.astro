---
const projects = [
  {
    title: 'Raven Task Board',
    type: 'личная task-система',
    stack: ['HTML', 'CSS', 'JavaScript', 'Node.js', 'Obsidian', 'Syncthing'],
    text: 'Мини-сайт для личной операционки: канбан по направлениям, матрица срочно/важно, архив закрытых задач, синхронизация с Obsidian и маленький ворон-наблюдатель.',
    link: 'https://github.com/NeMarusia/raven-task-board',
    demo: 'https://nemarusia.github.io/raven-task-board/',
    accent: 'raven',
  },
  {
    title: 'Prof Navigator AI',
    type: 'AI-профориентация',
    stack: ['Python', 'Flask', 'Celery', 'Redis', 'SQLite', 'Docker'],
    text: 'Сайт для детского конкурса: профориентационная анкета, генерация AI-результатов через Gen API, фоновые задачи через Celery и хранение результатов.',
    link: null,
    accent: 'career',
  },
  {
    title: 'mshp_event_bot',
    type: 'Telegram-бот для мероприятий',
    stack: ['Python', 'Aiogram', 'Google Sheets', 'Docker'],
    text: 'Event-бот для мероприятий МШП: регистрация, анкеты, согласия, запись данных и сервисная логика вокруг участников. Хороший пример автоматизации операционной рутины.',
    link: null,
    accent: 'bot',
  },
  {
    title: 'LessonBuddyBot',
    type: 'бот для замен',
    stack: ['Python', 'Telegram Bot API', 'SQLite'],
    text: 'Инструмент для заявок на замены преподавателей: сбор данных, статусы и уведомления куратору.',
    link: 'https://github.com/NeMarusia/LessonBuddyBot',
    accent: 'lesson',
  },
  {
    title: 'Arduino Distance Blynk',
    type: 'IoT-прототип',
    stack: ['Arduino', 'Python', 'HC-SR04', 'Blynk'],
    text: 'Сенсор расстояния на Arduino, который отправляет данные в Blynk Cloud через Python-мост.',
    link: 'https://github.com/NeMarusia/arduino-distance-blynk',
    accent: 'iot',
  },
  {
    title: 'TaskTraker',
    type: 'desktop-приложение',
    stack: ['Python', 'Tkinter', 'SQLite'],
    text: 'Локальный таск-трекер с дедлайнами, приоритетами, хранением задач и переключением языка интерфейса.',
    link: 'https://github.com/NeMarusia/TaskTraker',
    accent: 'desktop',
  },
  {
    title: 'AfterDeathAgency',
    type: 'игровой прототип',
    stack: ['Godot', 'GDScript', 'GameDev'],
    text: 'Небольшая атмосферная игра про агентство после смерти: сцены, персонажи, звуки и интерактивная логика на Godot.',
    link: 'https://github.com/NeMarusia/AfterDeathAgency',
    accent: 'ghost',
  },
];

const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Проекты Маргариты Сидоренко: EdTech automation, Telegram-боты, task-board, IoT, Python и игровые прототипы." />
    <title>Проекты — Маргарита Сидоренко</title>
  </head>
  <body>
    <div class="noise"></div>
    <header class="site-header">
      <a class="logo" href={base} aria-label="На главную">M<span>.</span></a>
      <nav aria-label="Основная навигация">
        <a href={base}>Главная</a>
        <a href={`${base}#experience`}>Опыт</a>
        <a href={`${base}#skills`}>Навыки</a>
        <a href={`${base}#contacts`}>Контакты</a>
      </nav>
    </header>

    <main>
      <section class="section hero">
        <p class="eyebrow">Selected work</p>
        <h1>Проекты</h1>
        <p class="lead">Отдельная витрина рабочих и личных проектов: автоматизация EdTech-процессов, боты, IoT, task-системы и прототипы. На главной — карьерный фокус, здесь — «посмотреть руками».</p>
        <a class="button" href={base}>← Вернуться на главную</a>
      </section>

      <section class="section projects-grid" aria-label="Список проектов">
        {projects.map((project) => (
          <article class={`project-card ${project.accent}`}>
            <div>
              <p class="project-type">{project.type}</p>
              <h2>{project.title}</h2>
              <p>{project.text}</p>
            </div>
            <ul class="tags" aria-label={`Стек проекта ${project.title}`}>
              {project.stack.map((item) => <li>{item}</li>)}
            </ul>
            <div class="project-actions">
              {project.demo && <a class="project-link" href={project.demo}>Открыть демо →</a>}
              {project.link ? (
                <a class="project-link" href={project.link}>Открыть репозиторий →</a>
              ) : (
                <span class="project-link muted-link">Репозиторий не прикреплён</span>
              )}
            </div>
          </article>
        ))}
      </section>
    </main>

    <footer>
      <p>© 2026 Маргарита Сидоренко. Проекты отдельно, как просили приличные люди и один уставший рекрутер.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #090914;
    --card: rgba(255, 255, 255, 0.075);
    --card-strong: rgba(255, 255, 255, 0.12);
    --text: #f5f1ff;
    --muted: #b7aecb;
    --line: rgba(255, 255, 255, 0.13);
    --violet: #a78bfa;
    --cyan: #67e8f9;
    --gold: #f7c873;
    --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(167, 139, 250, 0.32), transparent 32rem),
      radial-gradient(circle at 80% 10%, rgba(103, 232, 249, 0.18), transparent 30rem),
      var(--bg);
    color: var(--text);
  }
  a { color: inherit; text-decoration: none; }
  .noise { pointer-events:none; position:fixed; inset:0; opacity:.23; background-image:linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px); background-size:52px 52px; mask-image:linear-gradient(to bottom, black, transparent 85%); }
  .site-header { position:sticky; top:0; z-index:10; display:flex; align-items:center; justify-content:space-between; gap:1rem; width:min(1120px, calc(100% - 32px)); margin:0 auto; padding:18px 0; backdrop-filter:blur(14px); }
  .logo { display:grid; place-items:center; width:34px; height:34px; border:1px solid rgba(255,255,255,.1); border-radius:11px; background:rgba(255,255,255,.055); font-weight:850; }
  .logo span, .eyebrow { color: var(--cyan); }
  nav { display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; color:var(--muted); font-size:.95rem; }
  nav a { padding:9px 12px; border-radius:999px; }
  nav a:hover { background:rgba(255,255,255,.08); color:var(--text); }
  .section { width:min(1120px, calc(100% - 32px)); margin:0 auto; padding:70px 0; }
  .hero { padding-bottom:34px; }
  .eyebrow { margin:0 0 14px; text-transform:uppercase; letter-spacing:.16em; font-size:.78rem; font-weight:800; }
  h1,h2,p { margin-top:0; }
  h1 { max-width:760px; margin-bottom:20px; font-size:clamp(2.4rem, 6vw, 4.6rem); line-height:1; letter-spacing:-.055em; }
  h2 { margin-bottom:12px; font-size:1.35rem; }
  p { color:var(--muted); line-height:1.7; }
  .lead { max-width:760px; font-size:1.08rem; }
  .button, .project-link { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:0 18px; border:1px solid var(--line); border-radius:999px; background:rgba(255,255,255,.07); color:var(--text); font-weight:750; }
  .button:hover, .project-link:hover { transform:translateY(-1px); border-color:rgba(255,255,255,.28); background:rgba(255,255,255,.12); }
  .projects-grid { display:grid; grid-template-columns:repeat(2, minmax(0, 1fr)); gap:18px; padding-top:20px; }
  .project-card { position:relative; overflow:hidden; display:flex; min-height:310px; flex-direction:column; justify-content:space-between; padding:24px; border:1px solid var(--line); border-radius:28px; background:linear-gradient(180deg, var(--card-strong), var(--card)); box-shadow:var(--shadow); }
  .project-card::before { content:''; position:absolute; top:-70px; right:-80px; width:190px; height:190px; border-radius:999px; background:var(--accent, rgba(167,139,250,.25)); filter:blur(6px); opacity:.6; }
  .project-card > * { position:relative; }
  .ghost { --accent: rgba(167,139,250,.38); } .bot { --accent: rgba(103,232,249,.28); } .lesson { --accent: rgba(247,200,115,.25); } .iot { --accent: rgba(134,239,172,.25); } .desktop { --accent: rgba(251,113,133,.22); } .raven { --accent: rgba(167,139,250,.42); } .career { --accent: rgba(52,211,153,.24); }
  .project-type { color:var(--gold); font-weight:800; }
  .tags { display:flex; flex-wrap:wrap; gap:8px; margin:22px 0; padding:0; list-style:none; }
  .tags li { padding:7px 10px; border:1px solid var(--line); border-radius:999px; color:#ddd7f0; background:rgba(0,0,0,.18); font-size:.85rem; font-weight:700; }
  .project-actions { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:auto; }
  .project-link { width:fit-content; color:var(--cyan); }
  .muted-link { color:var(--muted); font-weight:800; }
  footer { width:min(1120px, calc(100% - 32px)); margin:0 auto; padding:38px 0 54px; border-top:1px solid var(--line); }
  footer p { margin:0; }
  @media (max-width: 820px) { .site-header { align-items:flex-start; } nav { font-size:.86rem; } .projects-grid { grid-template-columns:1fr; } .section { padding:54px 0; } }
</style>
