const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const portraitSrc = `${base}images/marsi-portrait.jpg`;
const projectsHref = `${base}projects/`;
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Портфолио Маргариты Сидоренко: project / program management в EdTech, образовательные процессы, операции, мероприятия, аналитика и автоматизация."
    />
    <title>Маргарита Сидоренко — портфолио</title>
  </head>
  <body>
    <div class="noise"></div>
    <header class="site-header">
      <a class="logo" href="#top" aria-label="На главную">M<span>.</span></a>
      <nav aria-label="Основная навигация">
        <a href="#about">Обо мне</a>
        <a href="#experience">Опыт</a>
        <a href="#education">Образование</a>
        <a href="#skills">Навыки</a>
        <a href={projectsHref}>Проекты</a>
        <a href="#contacts">Контакты</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero section">
        <div class="hero-copy">
          <p class="eyebrow">EdTech project management • operations • образовательные продукты</p>
          <h1>Привет, я Маргарита. Управляю образовательными проектами так, чтобы процессы не разваливались, люди понимали задачи, а результат был виден.</h1>
          <p class="lead">
            Мой фокус — project / program management в образовании: запуск учебных процессов, координация команд, регламенты,
            мероприятия, аналитика, коммуникации и аккуратная автоматизация рутины. Технологии для меня — не самоцель, а способ сделать систему понятнее и устойчивее.
          </p>
          <div class="hero-actions">
            <a class="button primary" href="#experience">Смотреть опыт</a>
            <a class="button" href={projectsHref}>Проекты отдельно</a>
          </div>
        </div>
        <aside class="hero-card" aria-label="Краткая карточка">
          <div class="portrait-row">
            <img class="portrait" src={portraitSrc} alt="Портрет Маргариты Сидоренко" loading="eager" />
            <p class="card-label">Сейчас в фокусе</p>
          </div>
          <h2>EdTech PM / Operations</h2>
          <p>
            Помогаю выстраивать образовательные процессы как понятную систему: от запуска программ и координации команд до аналитики, документации и операционной устойчивости.
          </p>
        </aside>
      </section>

      <section class="section about-block" id="about">
        <div class="section-heading">
          <p class="eyebrow">About</p>
          <h2>Обо мне</h2>
        </div>
        <div class="about-copy">
          <p>
            Я люблю образовательные проекты, где быстро видно результат: расписание стало прозрачнее, команда понимает зоны ответственности,
            участники не теряются в коммуникациях, а руководителю не нужно вытаскивать статус из хаоса вручную.
          </p>
          <p>
            У меня есть опыт в EdTech-процессах и маркетинге: учебная логистика на 300+ участников, мероприятия на 1000+ человек,
            партнёрская база 100+ организаций, регламенты, Bitrix24/LMS, Яндекс.Метрика, командная координация, подрядчики,
            бюджетирование и коммуникации со стейкхолдерами. Технические проекты и автоматизация — мой способ не просто «красиво придумать», а довести идею до работающего инструмента.
          </p>
        </div>
      </section>

      <section class="section highlights" aria-label="Ключевые цифры">
        {highlights.map(([value, label]) => (
          <article class="highlight-card">
            <strong>{value}</strong>
            <span>{label}</span>
          </article>
        ))}
      </section>

      <section class="section" id="experience">
        <div class="section-heading">
          <p class="eyebrow">Experience</p>
          <h2>Опыт</h2>
          <p>Управление образовательными программами, люди, процессы, мероприятия, коммуникации и автоматизация рутины.</p>
        </div>
        <div class="experience-list">
          {experience.map((item) => (
            <article class="experience-card">
              <div class="experience-meta">
                <p class="project-type">{item.period}</p>
                <h3>{item.role}</h3>
                <p>{item.company}</p>
              </div>
              <ul>
                {item.points.map((point) => <li>{point}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section" id="education">
        <div class="section-heading">
          <p class="eyebrow">Education</p>
          <h2>Образование</h2>
          <p>Педагогика, информатика, технологии и IoT — та самая база, из которой выросла связка EdTech + automation.</p>
        </div>
        <div class="education-grid">
          {education.map((item) => (
            <article class="education-card">
              <p class="project-type">{item.period}</p>
              <h3>{item.degree}</h3>
              <p class="education-place">{item.place}</p>
              <p>{item.details}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section split" id="skills">
        <div class="section-heading sticky-ish">
          <p class="eyebrow">Toolbox</p>
          <h2>Навыки</h2>
          <p>Ключевые зоны для управления образовательными проектами: процессы, люди, коммуникации, аналитика и техническая грамотность.</p>
        </div>
        <div class="skills-list grouped-skills">
          {skillGroups.map((group) => (
            <article class="skill-item skill-group">
              <h3>{group.title}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <section class="section contacts" id="contacts">
        <p class="eyebrow">Contacts</p>
        <h2>Связаться</h2>
        <div class="contact-links">
          <a href="mailto:sidorenko.margo.ru@yandex.ru">sidorenko.margo.ru@yandex.ru</a>
          <a href="https://t.me/SidorenkoMN">Telegram</a>
        </div>
      </section>
    </main>

    <footer>
      <p>© 2026 Маргарита Сидоренко. Собрано на Astro и домашнем серверном упрямстве.</p>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    --bg: #090914;
    --bg-soft: #111125;
    --card: rgba(255, 255, 255, 0.075);
    --card-strong: rgba(255, 255, 255, 0.12);
    --text: #f5f1ff;
    --muted: #b7aecb;
    --line: rgba(255, 255, 255, 0.13);
    --violet: #a78bfa;
    --cyan: #67e8f9;
    --gold: #f7c873;
    --pink: #fb7185;
    --green: #86efac;
    --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(167, 139, 250, 0.32), transparent 32rem),
      radial-gradient(circle at 80% 10%, rgba(103, 232, 249, 0.18), transparent 30rem),
      radial-gradient(circle at 60% 80%, rgba(251, 113, 133, 0.12), transparent 34rem),
      var(--bg);
    color: var(--text);
  }

  a { color: inherit; text-decoration: none; }

  .noise {
    pointer-events: none;
    position: fixed;
    inset: 0;
    opacity: 0.23;
    background-image:
      linear-gradient(rgba(255,255,255,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.03) 1px, transparent 1px);
    background-size: 52px 52px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 18px 0;
    backdrop-filter: blur(14px);
  }

  .logo {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid rgba(255,255,255,.1);
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.055);
    font-size: .86rem;
    font-weight: 850;
    box-shadow: none;
  }

  .logo span { color: var(--cyan); }

  nav {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: flex-end;
    color: var(--muted);
    font-size: 0.95rem;
  }

  nav a {
    padding: 9px 12px;
    border-radius: 999px;
  }

  nav a:hover { background: rgba(255,255,255,.08); color: var(--text); }

  .section {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 88px 0;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(260px, 0.55fr);
    align-items: center;
    gap: 34px;
    min-height: calc(100vh - 82px);
    padding-top: 42px;
  }

  .eyebrow {
    margin: 0 0 14px;
    color: var(--cyan);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 800;
  }

  h1, h2, h3, p { margin-top: 0; }

  h1 {
    max-width: 760px;
    margin-bottom: 22px;
    font-size: clamp(2rem, 4.05vw, 3.45rem);
    line-height: 1.08;
    letter-spacing: -0.048em;
  }

  h2 {
    margin-bottom: 18px;
    font-size: clamp(2rem, 4vw, 3.3rem);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  h3 { margin-bottom: 10px; font-size: 1.3rem; }

  p { color: var(--muted); line-height: 1.7; }

  .lead {
    max-width: 700px;
    font-size: 1.02rem;
  }

  .hero-actions, .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button, .contact-links a, .project-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255,255,255,.07);
    color: var(--text);
    font-weight: 750;
  }

  .button:hover, .contact-links a:hover, .project-link:hover {
    transform: translateY(-1px);
    border-color: rgba(255,255,255,.28);
    background: rgba(255,255,255,.12);
  }

  .primary {
    border-color: transparent;
    background: linear-gradient(135deg, var(--violet), var(--cyan));
    color: #070711;
  }

  .hero-card, .project-card, .experience-card, .education-card, .skill-item, .about-block, .contacts {
    border: 1px solid var(--line);
    border-radius: 28px;
    background: linear-gradient(180deg, var(--card-strong), var(--card));
    box-shadow: var(--shadow);
  }

  .hero-card {
    position: relative;
    overflow: hidden;
    padding: 20px;
    max-width: 292px;
    justify-self: end;
  }

